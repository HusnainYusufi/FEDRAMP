###############################################################################
# FedRAMP AI Studio — Example Environment (rename to .env)
#
# Copy to .env and adjust values:
#   macOS/Linux:  cp env.example .env
#   Windows PS:   Copy-Item env.example .env
#
# NOTE: Docker Compose also reads `.env` automatically for variable substitution,
# but this repo may block committing dot-env files. Use `env.example` as the source.
###############################################################################

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Database
# - The FastAPI app uses SQLAlchemy asyncio with psycopg3
# - Alembic + scripts use sync psycopg3 via SQLAlchemy
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://fedramp:fedramp@localhost:5432/fedramp
DATABASE_URL_SYNC=postgresql+psycopg://fedramp:fedramp@localhost:5432/fedramp

# -----------------------------------------------------------------------------
# AWS (ingestion credential source)
# The service will AssumeRole into the target account provided at runtime.
# These credentials are only used to call STS AssumeRole.
# -----------------------------------------------------------------------------
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional: default ExternalId to use for AssumeRole (can also be per-tenant)
AWS_DEFAULT_EXTERNAL_ID=

# Optional: STS session duration in seconds (default 3600)
AWS_SESSION_DURATION=3600

# -----------------------------------------------------------------------------
# OpenAI (Assessment AI / narrative generation)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_IMAGE_MODEL=gpt-5
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Assessment AI tooling
# -----------------------------------------------------------------------------
# Max number of evidence tool calls per narrative generation
ASSESSMENT_AI_MAX_TOOL_CALLS=5

# Default cap used by tools for returning sample records
ASSESSMENT_AI_DEFAULT_SAMPLE_LIMIT=10

# Optional comma-separated allowlist of tool names.
# Empty means "all tools enabled".
# Example:
# ASSESSMENT_AI_ENABLED_TOOLS=aws_default_evidence_snapshot,aws_list_records
ASSESSMENT_AI_ENABLED_TOOLS=

