# --------------------------------------------------------------------------
# FedRAMP Ingestion Core — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# --------------------------------------------------------------------------

# Database (psycopg3 works for async app + sync Alembic)
DATABASE_URL=postgresql+psycopg://fedramp:fedramp@localhost:5432/fedramp
DATABASE_URL_SYNC=postgresql+psycopg://fedramp:fedramp@localhost:5432/fedramp

# Application
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# OpenAI (Assessment AI / narrative generation)
# Required for `/ai/*` endpoints that call the LLM.
OPENAI_API_KEY=
# Optional overrides
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_TOKENS=4096

# LlamaIndex / LlamaParse (optional)
# If set, template parsing will use Llama Cloud parsing instead of the local DOCX reader.
LLAMA_CLOUD_API_KEY=

# AWS — these are only needed when running outside Docker
# and not using instance profiles / ECS task roles.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Optional: External ID for AssumeRole (prevents confused-deputy)
# AWS_DEFAULT_EXTERNAL_ID=

# STS session duration in seconds (default 3600)
# AWS_SESSION_DURATION=3600
